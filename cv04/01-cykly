#include <stdio.h>

int main(void)
{
    /* FOR */
    for(int i = 1; i <= 10; i++ )
    {
        printf(" %2d", i);
    }
    printf("\n");

    /*WHILE*/

    int j = 1;
    while(j <=10)
    {
        printf("%2d", j);
        j++;
    }
    printf("\n");

    /*DO WHILE*/
    j =
    do
    {
        printf(" %2d", j++);
    } while (j <= 10);

    return 0;
}
