#include <stdio.h>

int main(void)
{
    int i;//deklaruji pred cyklem, abych mohl vycist naslednou hodontu
    /* FOR */
    for(int i = 1; i <= 10; i++ )
    {
        if(i == 3){
            continue; //preskoci zbytek iterace cyklu
        }
        if(i == 7) break;
        printf(" %2d", i);
    }
    
    
    printf("\n");
    printf("i po cyklu = %d\n", i);

    int n;
    printf("Zadejte cislo:\n");
    scanf("%d", &n);

    int soucet = 0;
    for(int i = 0; i <= n; i++ )
    {
        soucet = soucet + i;
        
    }
    printf(" soucet cisel od 0 do %d je %d\n", n, soucet);
    return 0;

    int tmp = -1;
    for(i = 1; i <= n; i++ )
    {
        printf(" %+2d", tmp);
        tmp *= -1;
    }
    return 0;
}
